{
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "@shopify/prettier-plugin-liquid": "^1.7.2",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.4.2",
    "purgecss": "^8.0.0",
    "start-server-and-test": "^3.0.11"
  },
  "scripts": {
    "build": "bundle exec jekyll build",
    "dev": "bundle exec jekyll serve --host localhost --port 4000 --livereload --open-url",
    "format": "prettier --list-different --write . --ignore-path ''",
    "purge-css": "node scripts/purge-css.js",
    "rubocop": "bundle exec rubocop",
    "test-a11y": "start-server-and-test 'http-server _site -p 8080 -s' http://localhost:8080 'pa11y-ci --config .pa11yci.json'",
    "test-links": "bundle exec htmlproofer --assume_extension '.html' ./_site --ignore-urls \"/^http://127.0.0.1/,/^http://0.0.0.0/,/^http://localhost/\" --disable-external"
  },
  "author": "Jan Sroka <jan.sroka@inoeg.de>",
  "license": "UNLICENSED"
}
